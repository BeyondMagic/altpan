{
  "manifest_version": 3,
  "name": "AltPan - Drag-to-Pan for Firefox",
  "version": "1.2.0",
  "description": "Smoothly pan zoomed webpages and visual viewports with a 1:1 hand-tool drag gesture.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "AltPan Settings"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "experiment_apis": {
    "altpan": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["altpan"]],
        "script": "experiment/api.js"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "altpan@terra.local",
      "strict_min_version": "109.0"
    }
  }
}
